CM_ BO_ 768 "Measurment of cabin temparature.";
CM_ SG_ 768 PGR_SET_TEMP "Protected signal for w105 program.";
CM_ SG_ 768 DRV_SET_TEMP "Protected signal for w105 program.
";
CM_ SG_ 768 DISP_DUAL "Protected signal for w105 program.";
CM_ SG_ 768 STS_REAR_AC "this signal is protected for w105 program.";
CM_ SG_ 768 DISP_AC "this signal is protected for w105 program.";
CM_ SG_ 768 DISP_MODE "FATC mode display";
CM_ SG_ 768 FRESH_RECIRC "Fresh Air/Recirc";
CM_ SG_ 768 DISP_BLOWER "Blower Display";
CM_ SG_ 768 FATC_ECON "Protected signal for w105 program.";
CM_ SG_ 768 FATC_AUTO "Automatic FATC ON or OFF";
CM_ SG_ 553 RPAS_ERROR "bit 0: RL corner
bit 1: RLC
bit 2: RRC
bit 3: RR corner
bit 4: ECU fault (RPAS not functional)

0 - No error
1 - Error";
CM_ SG_ 2015 DIAG_GLOBAL_REQ_DATA "Keyword 2000 Diagnostic Message Request Data";
CM_ SG_ 540 AUTO_RAIN "Wiper ON/OFF";
CM_ SG_ 540 AUTO_LIGHT "Auto Light ON /OFF";
CM_ SG_ 540 SPARE_TYRE_PRESSURE "spare tyre pressure";
CM_ SG_ 540 SPARE_TYRE_TEMP "spare tyre temparature";
CM_ SG_ 840 DISP_AMBT_TEMP_MBFM "Display Ambient temperature in deg C
RPAS reveive OFV= 25deg c

check IC, EMS & ESC for which function they will use ??";
CM_ SG_ 840 STS_DOOR "Status of Back, Hood, Front-Left, Front-Right, Rear Left and Rear Right Doors. 
Bit0 - Back , Bit1 - Hood ,Bit2 - Front Left  , Bit3 - Front Right , Bit4 -Rear Left , Bit5 - Rear Right
0 - Closed, 1 - Open
";
CM_ SG_ 840 ENG_OFF_TIME "Engine off time
EMS - does used this signal??
IS - ??
";
CM_ SG_ 536 RR_TYRE_TEMP "rear right tyre temparature

The display unit shall show __ upon receiving this default value
The display unit shall show __ upon MBFM node absent
";
CM_ SG_ 536 RL_TYRE_TEMP "rear left tyre temparature

The display unit shall show __ upon receiving this default value
The display unit shall show __ upon MBFM node absent
";
CM_ SG_ 536 FR_TYRE_TEMP "front right tyre temparature

The display unit shall show __ upon receiving this default value
The display unit shall show __ upon MBFM node absent
";
CM_ SG_ 536 FL_TYRE_TEMP "front left tyre temparature

The display unit shall show __ upon receiving this default value
The display unit shall show __ upon MBFM node absent
";
CM_ SG_ 536 RR_TYRE_PRESSURE "rear right tyre pressure

The display unit shall show __ upon receiving this default value
The display unit shall show __ upon MBFM node absent
";
CM_ SG_ 536 RL_TYRE_PRESSURE "rear left tyre pressure

The display unit shall show __ upon receiving this default value
The display unit shall show __ upon MBFM node absent
";
CM_ SG_ 536 FR_TYRE_PRESSURE "front right tyre pressure

